# Docker ignore file
# Prevents unnecessary files from being copied to the build context

# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
out
build
dist

# Development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing
coverage
.nyc_output

# IDE & Editor
.idea
.vscode
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Environment files (never include secrets in images)
.env
.env.*
!.env.example

# Documentation
README.md
docs
*.md

# Misc
.dockerignore
Dockerfile
docker-compose*.yml
